# DOHSaving-Web - Environment Variables
# Copy this file to .env.local and fill in real values

# Public site URL used for canonical URLs, Open Graph, robots, and sitemap
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Database (MariaDB)
DATABASE_URL="mysql://user:password@localhost:3306/dohsaving"

# JWT Authentication (REQUIRED - server will NOT start without this)
JWT_SECRET="generate-a-strong-random-string-at-least-32-chars"
JWT_EXPIRES_IN="8h"

# อ่าน IP จริงของผู้ใช้จาก header X-Forwarded-For ที่ IIS ส่งต่อมา
# ตั้ง true เฉพาะเมื่อแอปอยู่หลัง reverse proxy (IIS) และปิดพอร์ต 3000 จากภายนอกแล้วเท่านั้น
# ไม่ตั้ง = IP ทุกคนเป็น "unknown" → สถิติผู้เข้าชมไม่ซ้ำและการกันสแปมใช้ไม่ได้
TRUST_PROXY_HEADERS="true"

# แจ้งเตือนเจ้าหน้าที่ทาง Telegram (ไม่บังคับ — ไม่ตั้ง = ปิดแจ้งเตือน) ดูวิธีตั้งใน DEPLOY.md
# แจ้งเมื่อ: มีเรื่องร้องเรียนใหม่ · คำถามใหม่ · สมาชิกถามต่อ · สรุปงานค้างทุกเช้าวันทำการ
TELEGRAM_BOT_TOKEN=""
# chat id ของกลุ่มเจ้าหน้าที่ (หลายกลุ่มคั่นด้วย ,) — หาได้ด้วย npm run telegram:test
TELEGRAM_CHAT_ID=""

# Node Environment
NODE_ENV="production"
